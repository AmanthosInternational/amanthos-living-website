{
  "version": "1",
  "zweck": "DOM-Kontrakt K5 zwischen dem Abschnitt Wohnen auf Zeit in zurich/index.html (Segment 1) und js/longstay-page.js (Segment 2). Segment 1 setzt jede ID genau einmal, Segment 2 spricht nur diese IDs an. Die data-i18n-Schluessel liegen unter longstay.* in locales/de.json und locales/en.json (Segment 1); der Text im HTML ist die deutsche Fassung. Abschnitt und Nav-Eintrag tragen hidden, bis die Verdrahtung sie freischaltet.",
  "page": "zurich/index.html",
  "script": "js/longstay-page.js",
  "skeleton": "tests/fixtures/longstay-skeleton.html",
  "section": "wohnen-auf-zeit",
  "nav": "ls-nav",
  "ids": [
    "wohnen-auf-zeit",
    "ls-nav",
    "ls-price",
    "ls-price-note",
    "ls-book",
    "ls-form",
    "ls-name",
    "ls-email",
    "ls-phone",
    "ls-movein",
    "ls-duration",
    "ls-persons",
    "ls-message",
    "ls-company-website",
    "ls-submit",
    "ls-status",
    "ls-success"
  ],
  "hidden_until_wiring": ["wohnen-auf-zeit", "ls-nav"],
  "hidden_initially": ["ls-book", "ls-success"],
  "fields": {
    "ls-form": { "tag": "form", "attrs": { "novalidate": "" } },
    "ls-name": { "tag": "input", "attrs": { "type": "text", "name": "name", "autocomplete": "name", "required": "" } },
    "ls-email": { "tag": "input", "attrs": { "type": "email", "name": "email", "required": "" } },
    "ls-phone": { "tag": "input", "attrs": { "type": "tel", "name": "phone" } },
    "ls-movein": { "tag": "input", "attrs": { "type": "month", "name": "move_in" } },
    "ls-duration": { "tag": "input", "attrs": { "type": "number", "name": "duration_months", "min": "1", "max": "24", "step": "1" } },
    "ls-persons": { "tag": "select", "attrs": { "name": "persons" }, "options": ["1", "2", "3"] },
    "ls-message": { "tag": "textarea", "attrs": { "name": "message" } },
    "ls-company-website": { "tag": "input", "attrs": { "type": "text", "name": "company_website", "tabindex": "-1", "autocomplete": "off" } },
    "ls-submit": { "tag": "button", "attrs": { "type": "submit" } },
    "ls-status": { "tag": "p", "attrs": { "role": "status" } },
    "ls-success": { "tag": "div", "attrs": { "hidden": "" } }
  },
  "notes": [
    "ls-movein: min ist der laufende Monat, max der laufende Monat plus 18 (YYYY-MM); die Werte sind datumsabhaengig und werden nicht gegen das Fixture geprueft.",
    "ls-company-website ist der Honigtopf und steht in <div class=\"ls-hp\" aria-hidden=\"true\">.",
    "ls-book bleibt hidden, solange window.amanthosBooking fehlt (K2)."
  ],
  "classes_existing": [
    "section",
    "section-alt",
    "container",
    "container-narrow",
    "section-label",
    "section-title",
    "section-subtitle",
    "btn",
    "btn-accent",
    "btn-lg",
    "btn-outline",
    "form-grid",
    "form-field"
  ],
  "classes_new": [
    "ls-section",
    "ls-price",
    "ls-price-note",
    "ls-benefits",
    "ls-hp",
    "ls-status",
    "ls-success",
    "ls-actions"
  ],
  "i18n_keys": [
