    "longstay.label",
    "longstay.title",
    "longstay.intro",
    "longstay.price_loading",
    "longstay.benefit_kitchen",
    "longstay.benefit_wifi",
    "longstay.benefit_desk",
    "longstay.benefit_parking",
    "longstay.benefit_checkin",
    "longstay.benefit_airport",
    "longstay.form_title",
    "longstay.name",
    "longstay.email",
    "longstay.phone",
    "longstay.move_in",
    "longstay.duration",
    "longstay.persons",
    "longstay.message",
    "longstay.submit",
    "longstay.note",
    "longstay.book"
  ]
}
